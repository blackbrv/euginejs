{
  "name": "eugine",
  "version": "0.1.2",
  "description": "Eugine: an extensible engine for building drag-and-drop visual editors and page builders. Install this package to get the core engine, plus eugine/renderer and eugine/server for browser and server-safe rendering, and eugine/versioning for persistent document versions.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./versioning": {
      "import": {
        "types": "./dist/versioning.d.ts",
        "default": "./dist/versioning.js"
      },
      "require": {
        "types": "./dist/versioning.d.cts",
        "default": "./dist/versioning.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@euginejs/core": "0.1.1",
    "@euginejs/renderer": "0.1.2",
    "@euginejs/renderer-server": "0.1.2",
    "@euginejs/versioning": "0.1.2"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eugine",
    "editor",
    "page-builder",
    "website-builder",
    "visual-editor",
    "drag-and-drop",
    "no-code",
    "low-code"
  ],
  "engines": {
    "node": ">=18.18.0"
  }
}
