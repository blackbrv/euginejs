{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "description": "The Eugine documentation site: guides, concepts, a generated API reference, and live in-page editors built on the library itself.",
  "scripts": {
    "dev": "next dev -p 3003",
    "prebuild": "npm run api",
    "build": "next build",
    "start": "next start -p 3003",
    "api": "typedoc && node scripts/api-frontmatter.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "eugine": "0.1.2",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.0",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
